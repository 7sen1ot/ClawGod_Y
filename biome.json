{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  "files": { "includes": ["src/shared/**/*.mjs", "src/ci/**/*.mjs", "build.js", "!src/shared/acorn.mjs"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": { "noUnreachable": "error" },
      "suspicious": { "noDuplicateObjectKeys": "error", "noDuplicateParameters": "error", "noRedeclare": "error" }
    }
  }
}
